{
    "issue": "DEV-0026",
    "mutants": [
        {
            "id": "M1",
            "description": "Realm deixa de usar o tema fithub no login",
            "area": "tools",
            "file": "infra/keycloak/realm-fithub.json",
            "find": "\"loginTheme\": \"fithub\"",
            "replace": "\"loginTheme\": \"keycloak.v2\"",
            "command": [
                "node",
                "--test",
                "infra/keycloak/realm.test.mjs"
            ]
        },
        {
            "id": "M2",
            "description": "Realm deixa de usar o tema fithub nos e-mails",
            "area": "tools",
            "file": "infra/keycloak/realm-fithub.json",
            "find": "\"emailTheme\": \"fithub\"",
            "replace": "\"emailTheme\": \"base\"",
            "command": [
                "node",
                "--test",
                "infra/keycloak/realm.test.mjs"
            ]
        },
        {
            "id": "M3",
            "description": "Tema de login passa a carregar um script próprio",
            "area": "tools",
            "file": "infra/keycloak/themes/fithub/login/theme.properties",
            "find": "locales=pt-BR",
            "replace": "locales=pt-BR\nscripts=js/extra.js",
            "command": [
                "node",
                "--test",
                "infra/keycloak/realm.test.mjs"
            ]
        },
        {
            "id": "M4",
            "description": "Tema de login deixa de herdar as telas do keycloak.v2",
            "area": "tools",
            "file": "infra/keycloak/themes/fithub/login/theme.properties",
            "find": "parent=keycloak.v2",
            "replace": "parent=base",
            "command": [
                "node",
                "--test",
                "infra/keycloak/realm.test.mjs"
            ]
        },
        {
            "id": "M5",
            "description": "CSS do tema carrega imagem de outro domínio",
            "area": "tools",
            "file": "infra/keycloak/themes/fithub/login/resources/css/fithub.css",
            "find": "background: var(--fithub-surface) none;",
            "replace": "background: url(https://exemplo.invalid/fundo.png);",
            "command": [
                "node",
                "--test",
                "infra/keycloak/realm.test.mjs"
            ]
        },
        {
            "id": "M6",
            "description": "Moldura do e-mail carrega imagem (rastreio de abertura)",
            "area": "tools",
            "file": "infra/keycloak/themes/fithub/email/html/template.ftl",
            "find": "<#nested>",
            "replace": "<img src=\"pixel.png\" alt=\"\"><#nested>",
            "command": [
                "node",
                "--test",
                "infra/keycloak/realm.test.mjs"
            ]
        },
        {
            "id": "M7",
            "description": "Mensagem de cadastro revela que o e-mail já tem conta",
            "area": "tools",
            "file": "infra/keycloak/themes/fithub/login/messages/messages_pt_BR.properties",
            "find": "emailExistsMessage=Não foi possível criar a conta com esse e-mail.",
            "replace": "emailExistsMessage=Este e-mail já existe.",
            "command": [
                "node",
                "--test",
                "infra/keycloak/realm.test.mjs"
            ]
        },
        {
            "id": "M8",
            "description": "Mensagem de login distingue e-mail inexistente de senha errada",
            "area": "tools",
            "file": "infra/keycloak/themes/fithub/login/messages/messages_pt_BR.properties",
            "find": "invalidUserMessage=E-mail ou senha inválidos.",
            "replace": "invalidUserMessage=E-mail não encontrado.",
            "command": [
                "node",
                "--test",
                "infra/keycloak/realm.test.mjs"
            ]
        },
        {
            "id": "M9",
            "description": "Redirect URI do web aponta para host de terceiro (achado do PR #190)",
            "area": "tools",
            "file": "infra/keycloak/realm-fithub.json",
            "find": "\"redirectUris\": [\"http://localhost:5173/*\"]",
            "replace": "\"redirectUris\": [\"http://terceiro.example/*\"]",
            "command": [
                "node",
                "--test",
                "infra/keycloak/realm.test.mjs"
            ]
        },
        {
            "id": "M10",
            "description": "Origem do web aponta para host de terceiro (achado do PR #190)",
            "area": "tools",
            "file": "infra/keycloak/realm-fithub.json",
            "find": "\"webOrigins\": [\"http://localhost:5173\"]",
            "replace": "\"webOrigins\": [\"http://terceiro.example\"]",
            "command": [
                "node",
                "--test",
                "infra/keycloak/realm.test.mjs"
            ]
        }
    ]
}
