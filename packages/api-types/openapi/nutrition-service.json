  "info" : {
    "description" : "Alimentos, planos e registro de refeições.",
    "title" : "nutrition-service",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/clients/{clientId}" : {
      "get" : {
        "operationId" : "client",
        "parameters" : [ {
          "in" : "path",
          "name" : "clientId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LinkedClient"
                }
              }
            },
            "description" : "Cliente vinculado."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é nutricionista."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem vínculo ativo com o cliente (ou ele não existe)."
          }
        },
        "summary" : "Dados básicos de um cliente com vínculo ativo",
        "tags" : [ "Clientes" ]
      }
    },
    "/foods" : {
      "get" : {
        "description" : "Filtros opcionais, combinados (E lógico). O nome busca por trecho, sem diferenciar maiúsculas nem acentos. Os arquivados ficam de fora. Página a partir de 0, com 20 itens por padrão e até 50.",
        "operationId" : "searchFoods",
        "parameters" : [ {
          "description" : "Trecho do nome.",
          "in" : "query",
          "name" : "name",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "true para só os veganos; false para só os não veganos.",
          "in" : "query",
          "name" : "vegan",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Página, a partir de 0.",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : "0",
            "type" : "string"
          }
        }, {
          "description" : "Itens por página, de 1 a 50.",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : "20",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FoodPage"
                }
              }
            },
            "description" : "Página da busca."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Filtro fora das regras, página negativa ou tamanho fora de 1 a 50; o campo vem em errors."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é nutricionista."
          }
        },
        "summary" : "Busca na TACO e nos alimentos próprios da nutricionista",
        "tags" : [ "Alimentos" ]
      },
      "post" : {
        "operationId" : "createOwnFood",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/FoodInput"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Food"
                }
              }
            },
            "description" : "Alimento cadastrado; o endereço vem em Location."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Campo fora das regras ou ingrediente indisponível; o campo vem em errors."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é nutricionista."
          }
        },
        "summary" : "Cadastra um alimento ou receita própria da nutricionista",
        "tags" : [ "Alimentos" ]
      }
    },
    "/foods/{foodId}" : {
      "get" : {
        "operationId" : "viewFood",
        "parameters" : [ {
          "in" : "path",
          "name" : "foodId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
