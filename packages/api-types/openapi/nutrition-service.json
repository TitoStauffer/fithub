          "size" : {
            "format" : "int32",
            "type" : "integer"
          },
          "total" : {
            "description" : "Quantos alimentos atendem à busca, somando todas as páginas.",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "FoodSource" : {
        "description" : "Origem do item importado, para o crédito.",
        "properties" : {
          "externalId" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "FoodSummary" : {
        "description" : "Alimento no resultado da busca, com os valores por 100.",
        "properties" : {
          "baseUnit" : {
            "enum" : [ "G", "ML" ],
            "type" : "string"
          },
          "carbsG" : {
            "type" : "number"
          },
          "energyKcal" : {
            "type" : "number"
          },
          "fatG" : {
            "type" : "number"
          },
          "fiberG" : {
            "type" : "number"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "kind" : {
            "enum" : [ "TACO", "OWN" ],
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "proteinG" : {
            "type" : "number"
          },
          "recipe" : {
            "description" : "Se é uma receita da nutricionista.",
            "type" : "boolean"
          },
          "vegan" : {
            "type" : "boolean"
          }
        },
        "type" : "object"
      },
      "LinkedClient" : {
        "description" : "Dados básicos do cliente vinculado.",
        "properties" : {
          "birthDate" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "clientId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "gender" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Problem" : {
        "description" : "Erro no formato Problem Details (RFC 9457).",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
