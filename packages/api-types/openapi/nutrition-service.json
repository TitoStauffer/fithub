{
  "components" : {
    "schemas" : {
      "Food" : {
        "description" : "Alimento, com os valores por 100 da unidade base (100 g ou 100 ml).",
        "properties" : {
          "baseUnit" : {
            "description" : "G (gramas) ou ML (mililitros).",
            "enum" : [ "G", "ML" ],
            "type" : "string"
          },
          "carbsG" : {
            "type" : "number"
          },
          "energyKcal" : {
            "type" : "number"
          },
          "fatG" : {
            "type" : "number"
          },
          "fiberG" : {
            "description" : "Ausente quando a fonte não traz.",
            "type" : "number"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "kind" : {
            "enum" : [ "TACO", "OWN" ],
            "type" : "string"
          },
          "measures" : {
            "description" : "As medidas caseiras da nutricionista neste alimento (só as dela).",
            "items" : {
              "$ref" : "#/components/schemas/FoodMeasure"
            },
            "type" : "array"
          },
          "name" : {
            "type" : "string"
          },
          "proteinG" : {
            "type" : "number"
          },
          "source" : {
            "$ref" : "#/components/schemas/FoodSource",
            "description" : "Presente só no item importado."
          },
          "vegan" : {
            "type" : "boolean"
          }
        },
        "type" : "object"
      },
      "FoodMeasure" : {
        "description" : "Medida caseira da nutricionista e quanto vale na unidade base.",
        "properties" : {
          "amount" : {
            "description" : "Gramas (ou ml) de uma medida.",
            "type" : "number"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "FoodMeasureInput" : {
        "description" : "Medida caseira nova.",
        "properties" : {
          "amount" : {
            "description" : "De 0,1 a 2000 g (ou ml).",
            "type" : "number"
          },
          "name" : {
            "description" : "De 2 a 40 caracteres.",
            "type" : "string"
          }
        },
        "required" : [ "amount", "name" ],
        "type" : "object"
      },
      "FoodSource" : {
        "description" : "Origem do item importado, para o crédito.",
        "properties" : {
          "externalId" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "LinkedClient" : {
        "description" : "Dados básicos do cliente vinculado.",
        "properties" : {
          "birthDate" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "clientId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "gender" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Problem" : {
        "description" : "Erro no formato Problem Details (RFC 9457).",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "Alimentos, planos e registro de refeições.",
    "title" : "nutrition-service",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/clients/{clientId}" : {
      "get" : {
        "operationId" : "client",
        "parameters" : [ {
          "in" : "path",
          "name" : "clientId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LinkedClient"
                }
              }
            },
            "description" : "Cliente vinculado."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é nutricionista."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem vínculo ativo com o cliente (ou ele não existe)."
          }
        },
        "summary" : "Dados básicos de um cliente com vínculo ativo",
        "tags" : [ "Clientes" ]
      }
    },
    "/foods/{foodId}" : {
      "get" : {
        "operationId" : "viewFood",
        "parameters" : [ {
          "in" : "path",
          "name" : "foodId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Food"
                }
              }
            },
            "description" : "Alimento."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é nutricionista."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "O alimento não existe ou é próprio de outra nutricionista."
          }
        },
        "summary" : "Um alimento da TACO ou próprio da nutricionista",
        "tags" : [ "Alimentos" ]
      }
    },
    "/foods/{foodId}/measures" : {
      "post" : {
        "operationId" : "addFoodMeasure",
        "parameters" : [ {
          "in" : "path",
          "name" : "foodId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/FoodMeasureInput"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FoodMeasure"
                }
              }
            },
            "description" : "Medida cadastrada; o endereço vem em Location."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Nome ou valor fora das regras, nome repetido ou mais de 10 medidas; o campo vem em errors."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é nutricionista."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "O alimento não existe ou é próprio de outra nutricionista."
          }
        },
        "summary" : "Cadastra uma medida caseira da nutricionista no alimento",
        "tags" : [ "Alimentos" ]
      }
    },
    "/foods/{foodId}/measures/{measureId}" : {
      "delete" : {
        "operationId" : "removeFoodMeasure",
        "parameters" : [ {
          "in" : "path",
          "name" : "foodId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "measureId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Medida apagada."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é nutricionista."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A medida não existe, é de outro alimento ou de outra nutricionista."
          }
        },
        "summary" : "Apaga uma medida caseira da nutricionista",
        "tags" : [ "Alimentos" ]
      }
    }
  },
  "security" : [ {
    "bearer" : [ ]
  } ],
  "servers" : [ {
    "description" : "Generated server url",
    "url" : "http://localhost"
  } ],
  "tags" : [ {
    "description" : "Clientes vinculados ao nutricionista",
    "name" : "Clientes"
  }, {
    "description" : "Base de alimentos da nutricionista: TACO e alimentos próprios",
    "name" : "Alimentos"
  } ]
}
