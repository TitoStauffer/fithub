          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "O alimento não existe, é da TACO ou de outra nutricionista."
          }
        },
        "summary" : "Arquiva o alimento próprio: sai da busca, mas continua nos planos",
        "tags" : [ "Alimentos" ]
      }
    },
