        "properties" : {
          "ingredients" : {
            "items" : {
              "$ref" : "#/components/schemas/RecipeIngredient"
            },
            "type" : "array"
          },
          "yieldGrams" : {
            "type" : "number"
          }
        },
        "type" : "object"
      },
      "RecipeIngredient" : {
        "description" : "Ingrediente da receita: o alimento e a quantidade.",
        "properties" : {
          "amount" : {
            "description" : "De 0,1 a 5000 g (ou ml).",
            "type" : "number"
          },
          "foodId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "amount", "foodId" ],
        "type" : "object"
      },
      "RecipeInput" : {
        "description" : "Ingredientes (1 a 30) e o rendimento total.",
        "properties" : {
          "ingredients" : {
            "items" : {
              "$ref" : "#/components/schemas/RecipeIngredient"
            },
            "type" : "array"
          },
          "yieldGrams" : {
            "description" : "Em gramas, de 1 a 20000.",
            "type" : "number"
          }
        },
        "required" : [ "ingredients", "yieldGrams" ],
        "type" : "object"
      }
