          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "kind" : {
            "enum" : [ "TACO", "OWN" ],
            "type" : "string"
          },
          "measures" : {
            "description" : "As medidas caseiras da nutricionista neste alimento (só as dela).",
