          "amount" : {
            "description" : "De 0,1 a 2000 g (ou ml).",
            "type" : "number"
          },
          "name" : {
            "description" : "De 2 a 40 caracteres.",
            "type" : "string"
          }
        },
        "required" : [ "amount", "name" ],
        "type" : "object"
      },
      "FoodPage" : {
        "description" : "Página da busca de alimentos.",
