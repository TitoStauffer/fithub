{
  "components" : {
    "schemas" : {
      "Exercise" : {
        "description" : "Exercício do catálogo ou próprio do personal.",
        "properties" : {
          "archivedAt" : {
            "description" : "Quando o dono arquivou o exercício próprio; presente só se arquivado.",
            "format" : "date-time",
            "type" : "string"
          },
          "attribution" : {
            "$ref" : "#/components/schemas/ExerciseAttribution",
            "description" : "Presente só em exercício importado; a tela mostra o crédito."
          },
          "equipment" : {
            "enum" : [ "BARBELL", "DUMBBELL", "KETTLEBELL", "MACHINE", "CABLE", "BAND", "BODYWEIGHT", "OTHER" ],
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "instructions" : {
            "type" : [ "string", "null" ]
          },
          "kind" : {
            "enum" : [ "CATALOG", "OWN" ],
            "type" : "string"
          },
          "mediaUrl" : {
            "description" : "Vídeo ou imagem da execução, sempre https.",
            "type" : [ "string", "null" ]
          },
          "muscleGroups" : {
            "description" : "Grupos musculares, em ordem alfabética.",
            "items" : {
              "enum" : [ "CHEST", "BACK", "LOWER_BACK", "SHOULDERS", "BICEPS", "TRICEPS", "FOREARMS", "ABS", "GLUTES", "QUADRICEPS", "HAMSTRINGS", "ADDUCTORS", "CALVES", "NECK", "FULL_BODY" ],
              "type" : "string"
            },
            "type" : "array"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ExerciseAttribution" : {
        "description" : "Origem e licença do exercício importado (ADR-010).",
        "properties" : {
          "author" : {
            "type" : "string"
          },
          "license" : {
            "type" : "string"
          },
          "mediaAuthor" : {
            "description" : "Autor da mídia importada; presente só quando há mídia.",
            "type" : "string"
          },
          "mediaLicense" : {
            "description" : "Licença da mídia importada; presente só quando há mídia.",
            "type" : "string"
          },
          "source" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ExerciseInput" : {
        "description" : "Exercício próprio, com as mesmas regras do modelo.",
        "properties" : {
          "equipment" : {
            "enum" : [ "BARBELL", "DUMBBELL", "KETTLEBELL", "MACHINE", "CABLE", "BAND", "BODYWEIGHT", "OTHER" ],
            "type" : "string"
          },
          "instructions" : {
            "description" : "Até 4000 caracteres.",
            "type" : [ "string", "null" ]
          },
          "mediaUrl" : {
            "description" : "Vídeo ou imagem da execução, https de até 500 caracteres.",
            "type" : [ "string", "null" ]
          },
          "muscleGroups" : {
            "description" : "Um ou mais grupos musculares.",
            "items" : {
              "enum" : [ "CHEST", "BACK", "LOWER_BACK", "SHOULDERS", "BICEPS", "TRICEPS", "FOREARMS", "ABS", "GLUTES", "QUADRICEPS", "HAMSTRINGS", "ADDUCTORS", "CALVES", "NECK", "FULL_BODY" ],
              "type" : "string"
            },
            "type" : "array"
          },
          "name" : {
            "description" : "De 2 a 120 caracteres.",
            "type" : "string"
          }
        },
        "required" : [ "equipment", "muscleGroups", "name" ],
        "type" : "object"
      },
      "ExercisePage" : {
        "description" : "Uma página da busca, ordenada por nome.",
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/Exercise"
            },
            "type" : "array"
          },
          "page" : {
            "format" : "int32",
            "type" : "integer"
          },
          "size" : {
            "format" : "int32",
            "type" : "integer"
          },
          "total" : {
            "description" : "Quantos exercícios atendem à busca, somando todas as páginas.",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "LinkedClient" : {
        "description" : "Dados básicos do cliente vinculado.",
        "properties" : {
          "birthDate" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "clientId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "gender" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Problem" : {
        "description" : "Erro no formato Problem Details (RFC 9457).",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "description" : "Campos inválidos; presente só nas respostas 400.",
            "items" : {
              "$ref" : "#/components/schemas/ProblemFieldError"
            },
            "type" : [ "array", "null" ]
          },
          "instance" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProblemFieldError" : {
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "Exercícios, fichas, execuções e recordes.",
    "title" : "training-service",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/clients/{clientId}" : {
      "get" : {
        "operationId" : "client",
        "parameters" : [ {
          "in" : "path",
          "name" : "clientId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LinkedClient"
                }
              }
            },
            "description" : "Cliente vinculado."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é personal."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem vínculo ativo com o cliente (ou ele não existe)."
          }
        },
        "summary" : "Dados básicos de um cliente com vínculo ativo",
        "tags" : [ "Clientes" ]
      }
    },
    "/exercises" : {
      "get" : {
        "description" : "Filtros opcionais, combinados (E lógico). O nome busca por trecho, sem diferenciar maiúsculas nem acentos. Página a partir de 0, com 20 itens por padrão e até 50.",
        "operationId" : "search",
        "parameters" : [ {
          "description" : "Trecho do nome.",
          "in" : "query",
          "name" : "name",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "muscleGroup",
          "required" : false,
          "schema" : {
            "enum" : [ "CHEST", "BACK", "LOWER_BACK", "SHOULDERS", "BICEPS", "TRICEPS", "FOREARMS", "ABS", "GLUTES", "QUADRICEPS", "HAMSTRINGS", "ADDUCTORS", "CALVES", "NECK", "FULL_BODY" ],
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "equipment",
          "required" : false,
          "schema" : {
            "enum" : [ "BARBELL", "DUMBBELL", "KETTLEBELL", "MACHINE", "CABLE", "BAND", "BODYWEIGHT", "OTHER" ],
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 0,
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 20,
            "maximum" : 50,
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ExercisePage"
                }
              }
            },
            "description" : "Página da busca."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Filtro fora da lista, página negativa ou tamanho fora de 1 a 50; o campo vem em errors."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é personal."
          }
        },
        "summary" : "Busca no catálogo e nos exercícios próprios do personal",
        "tags" : [ "Exercícios" ]
      },
      "post" : {
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ExerciseInput"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Exercise"
                }
              }
            },
            "description" : "Exercício criado; o endereço vem em Location."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Campo fora das regras; o campo vem em errors."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é personal."
          }
        },
        "summary" : "Cria um exercício próprio do personal",
        "tags" : [ "Exercícios" ]
      }
    },
    "/exercises/{exerciseId}" : {
      "delete" : {
        "description" : "Não apaga: as fichas antigas continuam mostrando o exercício, que sai da busca. Arquivar de novo não muda nada.",
        "operationId" : "archive",
        "parameters" : [ {
          "in" : "path",
          "name" : "exerciseId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Exercício arquivado."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é personal."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "O exercício não existe, é de outro personal ou do catálogo."
          }
        },
        "summary" : "Arquiva um exercício próprio do personal",
        "tags" : [ "Exercícios" ]
      },
      "get" : {
        "operationId" : "exercise",
        "parameters" : [ {
          "in" : "path",
          "name" : "exerciseId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Exercise"
                }
              }
            },
            "description" : "Exercício."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é personal."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "O exercício não existe ou é próprio de outro personal."
          }
        },
        "summary" : "Um exercício do catálogo ou próprio do personal",
        "tags" : [ "Exercícios" ]
      },
      "put" : {
        "operationId" : "update",
        "parameters" : [ {
          "in" : "path",
          "name" : "exerciseId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ExerciseInput"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Exercise"
                }
              }
            },
            "description" : "Exercício editado."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Campo fora das regras; o campo vem em errors."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta não é personal."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "O exercício não existe, é de outro personal ou do catálogo."
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "O exercício foi arquivado e não muda mais."
          }
        },
        "summary" : "Edita um exercício próprio do personal",
        "tags" : [ "Exercícios" ]
      }
    }
  },
  "security" : [ {
    "bearer" : [ ]
  } ],
