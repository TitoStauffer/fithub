{
  "components" : {
    "schemas" : {
      "ClientProfile" : {
        "properties" : {
          "age" : {
            "description" : "Idade em anos completos, calculada a partir da data de nascimento.",
            "format" : "int32",
            "type" : "integer"
          },
          "birthDate" : {
            "format" : "date",
            "type" : "string"
          },
          "gender" : {
            "enum" : [ "FEMALE", "MALE", "OTHER", "PREFER_NOT_TO_SAY" ],
            "type" : "string"
          },
          "goal" : {
            "enum" : [ "WEIGHT_LOSS", "HYPERTROPHY", "CONDITIONING", "HEALTH", "OTHER" ],
            "type" : "string"
          },
          "heightCm" : {
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ClientProfileRequest" : {
        "properties" : {
          "birthDate" : {
            "format" : "date",
            "type" : "string"
          },
          "gender" : {
            "enum" : [ "FEMALE", "MALE", "OTHER", "PREFER_NOT_TO_SAY" ],
            "type" : "string"
          },
          "goal" : {
            "enum" : [ "WEIGHT_LOSS", "HYPERTROPHY", "CONDITIONING", "HEALTH", "OTHER" ],
            "type" : "string"
          },
          "heightCm" : {
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "birthDate", "gender", "goal", "heightCm", "name" ],
        "type" : "object"
      },
      "CreatedInvitation" : {
        "properties" : {
          "code" : {
            "description" : "Código de 8 caracteres; só aparece nesta resposta.",
            "type" : "string"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "emailSent" : {
            "description" : "Se o e-mail saiu; false sem e-mail ou se o envio falhou.",
            "type" : "boolean"
          },
          "expiresAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "link" : {
            "description" : "Link do convite; só aparece nesta resposta.",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "HealthProfile" : {
        "properties" : {
          "conditions" : {
            "items" : {
              "enum" : [ "DIABETES", "HYPERTENSION", "PREGNANCY", "RECENT_SURGERY", "OTHER" ],
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          },
          "notes" : {
            "type" : [ "string", "null" ]
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "HealthProfileRequest" : {
        "properties" : {
          "conditions" : {
            "description" : "Condições marcadas; repetidas contam uma vez.",
            "items" : {
              "enum" : [ "DIABETES", "HYPERTENSION", "PREGNANCY", "RECENT_SURGERY", "OTHER" ],
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          },
          "notes" : {
            "description" : "Texto livre opcional, até 1000 caracteres.",
            "maxLength" : 1000,
            "type" : "string"
          }
        },
        "required" : [ "conditions" ],
        "type" : "object"
      },
      "Invitation" : {
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "expiresAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "state" : {
            "enum" : [ "PENDING", "EXPIRED", "ACCEPTED", "CANCELLED" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "InvitationLookupRequest" : {
        "description" : "Informe o token do link ou o código.",
        "properties" : {
          "code" : {
            "type" : [ "string", "null" ]
          },
          "token" : {
            "type" : [ "string", "null" ]
          }
        },
        "type" : "object"
      },
      "InvitationPreview" : {
        "properties" : {
          "expiresAt" : {
            "description" : "Vazio para o código pessoal do profissional, que não vence.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "kind" : {
            "enum" : [ "INVITATION", "PROFESSIONAL_CODE" ],
            "type" : "string"
          },
          "professionalName" : {
            "type" : "string"
          },
          "professionalType" : {
            "enum" : [ "PERSONAL_TRAINER", "NUTRITIONIST" ],
            "type" : "string"
          },
          "sharedData" : {
            "items" : {
              "enum" : [ "PROFILE", "HEALTH", "ASSESSMENTS", "PHOTOS" ],
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          }
        },
        "type" : "object"
      },
      "InvitationRequest" : {
        "properties" : {
          "email" : {
            "description" : "E-mail do cliente; sem ele, o convite volta para o profissional compartilhar.",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "InviteCode" : {
        "properties" : {
          "code" : {
            "description" : "Código pessoal de 8 caracteres.",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Problem" : {
        "description" : "Erro no formato Problem Details (RFC 9457).",
        "properties" : {
          "detail" : {
            "description" : "Mensagem para a pessoa, em português.",
            "type" : "string"
          },
          "errors" : {
            "description" : "Campos inválidos; presente só nas respostas 400.",
            "items" : {
              "$ref" : "#/components/schemas/ProblemFieldError"
            },
            "type" : [ "array", "null" ]
          },
          "instance" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "description" : "URI do tipo do erro.",
            "example" : "about:blank",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProblemFieldError" : {
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
