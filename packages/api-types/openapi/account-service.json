{
  "components" : {
    "schemas" : {
      "Problem" : {
        "description" : "Erro no formato Problem Details (RFC 9457).",
        "properties" : {
          "detail" : {
            "description" : "Mensagem para a pessoa, em português.",
            "type" : "string"
          },
          "errors" : {
            "description" : "Campos inválidos; presente só nas respostas 400.",
            "items" : {
              "$ref" : "#/components/schemas/ProblemFieldError"
            },
            "type" : [ "array", "null" ]
          },
          "instance" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "description" : "URI do tipo do erro.",
            "example" : "about:blank",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProblemFieldError" : {
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Professional" : {
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "organizationId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "registration" : {
            "$ref" : "#/components/schemas/ProfessionalRegistration"
          },
          "roleStatus" : {
            "description" : "PENDING enquanto o papel de profissional não chega ao token; renove a sessão.",
            "enum" : [ "PENDING", "ASSIGNED" ],
            "type" : "string"
          },
          "situation" : {
            "enum" : [ "DECLARED" ],
            "type" : "string"
          },
          "type" : {
            "enum" : [ "PERSONAL", "NUTRITIONIST" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProfessionalRegistration" : {
        "properties" : {
          "category" : {
            "type" : "string"
          },
          "council" : {
            "enum" : [ "CREF", "CRN" ],
            "type" : "string"
          },
          "display" : {
            "type" : "string"
          },
          "number" : {
            "type" : "string"
          },
          "state" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProfessionalRegistrationRequest" : {
        "properties" : {
          "registrationCategory" : {
            "description" : "Categoria do CREF (G ou P). Não se aplica ao CRN.",
            "type" : [ "string", "null" ]
          },
          "registrationNumber" : {
            "minLength" : 1,
            "type" : "string"
          },
          "registrationState" : {
            "minLength" : 1,
            "type" : "string"
          },
          "type" : {
            "enum" : [ "PERSONAL", "NUTRITIONIST" ],
            "type" : "string"
          }
        },
        "required" : [ "registrationNumber", "registrationState", "type" ],
        "type" : "object"
      },
      "Subscription" : {
        "properties" : {
          "paidUntil" : {
            "description" : "Até quando o período pago vale; nulo enquanto nada foi pago.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "plan" : {
            "enum" : [ "PROFESSIONAL_MONTHLY" ],
            "type" : "string"
          },
          "status" : {
            "description" : "TRIAL no teste grátis, ACTIVE com período pago, EXPIRED sem nenhum dos dois.",
            "enum" : [ "TRIAL", "ACTIVE", "EXPIRED" ],
            "type" : "string"
          },
          "trialEndsAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "validUntil" : {
            "description" : "Até quando o profissional pode prescrever: o maior entre o teste e o pago.",
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "Profissional, organização e assinatura.",
    "title" : "account-service",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/professionals/me" : {
      "get" : {
        "description" : "404 se ainda não houver.",
        "operationId" : "mine",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Professional"
                }
              }
            },
            "description" : "Cadastro da conta autenticada."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta ainda não tem cadastro de profissional."
          }
        },
        "summary" : "Cadastro de profissional da conta autenticada",
        "tags" : [ "Profissional" ]
      },
      "post" : {
        "description" : "201 quando cria; 200 quando o mesmo cadastro já existia; 409 quando a conta já tem um cadastro diferente.",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ProfessionalRegistrationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Professional"
                }
              }
            },
            "description" : "O mesmo cadastro já existia."
          },
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Professional"
                }
              }
            },
            "description" : "Cadastro criado."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Campo inválido; errors[] traz o campo e a mensagem."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta já tem um cadastro com outros dados."
          }
        },
        "summary" : "Cadastra a conta autenticada como profissional",
        "tags" : [ "Profissional" ]
      }
    },
    "/professionals/me/subscription" : {
      "get" : {
        "operationId" : "getMySubscription",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Subscription"
                }
              }
            },
            "description" : "A assinatura, com o estado agora."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Sem token válido."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A conta ainda não tem cadastro de profissional."
          }
        },
        "summary" : "Plano e estado da assinatura do profissional da conta autenticada",
        "tags" : [ "Assinatura" ]
      }
    }
  },
  "security" : [ {
    "bearer" : [ ]
  } ],
  "servers" : [ {
    "description" : "Generated server url",
    "url" : "http://localhost"
  } ],
  "tags" : [ {
    "description" : "Plano e estado da assinatura do profissional",
    "name" : "Assinatura"
  }, {
    "description" : "Cadastro do profissional da conta autenticada",
    "name" : "Profissional"
  } ]
}
