{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fithub:event:client.link-ended.v1",
  "title": "VinculoEncerrado v1",
  "description": "O vínculo acabou: o profissional perde o acesso imediatamente (BR-05). Origem: client-service (exchange fithub.client). Consumidores: training-service e nutrition-service, que tiram o vínculo da projeção local.",
  "type": "object",
  "additionalProperties": false,
  "required": ["linkId", "clientId", "professionalId", "professionalType", "endedBy", "occurredAt"],
  "properties": {
    "linkId": { "type": "string", "format": "uuid", "description": "Id do vínculo, o mesmo do VinculoAtivado." },
    "clientId": { "type": "string", "format": "uuid" },
    "professionalId": { "type": "string", "format": "uuid" },
    "professionalType": { "enum": ["personal_trainer", "nutritionist"] },
    "endedBy": { "enum": ["client", "professional"], "description": "Quem encerrou (FR-12)." },
    "occurredAt": { "type": "string", "format": "date-time", "description": "Quando o vínculo foi encerrado, em UTC (ISO-8601)." }
  },
  "examples": [
    {
      "linkId": "01937c4e-8a2b-7f3c-9d1e-2b4c6d8e0f12",
      "clientId": "01937c4e-1111-7aaa-8bbb-000000000001",
      "professionalId": "01937c4e-2222-7ccc-8ddd-000000000002",
      "professionalType": "personal_trainer",
      "endedBy": "client",
      "occurredAt": "2026-11-23T08:30:00Z"
    }
  ]
}
