<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Contratos de evento entre serviços (DEV-0018, ADR-003): um JSON Schema por evento e versão, e o
    utilitário que valida um payload contra ele. Só contrato: nenhum tipo Java de evento entra aqui;
    cada serviço tem o próprio modelo (AGENTS.md: domínio compartilhado é proibido). Os serviços usam
    esta lib com escopo test, nos testes de produtor e de consumidor.
  -->
  <parent>
    <groupId>com.fithub</groupId>
    <artifactId>fithub-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>event-contracts</artifactId>
  <name>FitHub Event Contracts</name>

  <dependencies>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
