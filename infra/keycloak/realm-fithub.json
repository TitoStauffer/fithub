{
  "realm": "fithub",
  "enabled": true,
  "displayName": "FitHub",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "passwordPolicy": "length(8) and notUsername and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR"
  ],
  "defaultLocale": "pt-BR",
  "loginTheme": "fithub",
  "emailTheme": "fithub",
  "smtpServer": {
    "host": "${FITHUB_SMTP_HOST:mailpit}",
    "port": "${FITHUB_SMTP_PORT:1025}",
    "from": "${FITHUB_SMTP_FROM:no-reply@fithub.local}",
    "fromDisplayName": "FitHub",
    "ssl": "false",
    "starttls": "${FITHUB_SMTP_STARTTLS:false}",
    "auth": "${FITHUB_SMTP_AUTH:false}",
    "user": "${FITHUB_SMTP_USER:}",
    "password": "${FITHUB_SMTP_PASSWORD:}"
  },
  "defaultRole": {
    "name": "default-roles-fithub",
    "description": "Papéis de todo usuário novo: só client, além dos padrões do Keycloak",
    "composite": true,
    "clientRole": false
  },
  "roles": {
    "realm": [
      {
        "name": "default-roles-fithub",
        "description": "Papéis de todo usuário novo: só client, além dos padrões do Keycloak",
        "composite": true,
        "composites": {
          "realm": [
            "client",
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      },
      {
        "name": "client",
        "description": "Cliente (aluno ou paciente). Toda conta nova recebe este papel."
      },
      {
        "name": "personal",
        "description": "Personal trainer. Atribuído pelo account-service no cadastro do profissional.",
        "id": "7d1c2b3a-0147-4f00-9a01-000000000001"
      },
      {
        "name": "nutritionist",
        "description": "Nutricionista. Atribuído pelo account-service no cadastro do profissional.",
        "id": "7d1c2b3a-0147-4f00-9a01-000000000002"
      },
      {
        "name": "admin",
        "description": "Administração da plataforma. Atribuído manualmente."
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      }
    ]
  },
  "clients": [
    {
      "clientId": "fithub-web",
      "name": "FitHub Web (profissional)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${FITHUB_WEB_URL:http://localhost:5173}",
      "baseUrl": "/",
      "redirectUris": [
        "${FITHUB_WEB_URL:http://localhost:5173}/*"
      ],
      "webOrigins": [
        "${FITHUB_WEB_URL:http://localhost:5173}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FITHUB_WEB_URL:http://localhost:5173}/*"
      }
    },
    {
      "clientId": "fithub-mobile",
      "name": "FitHub App (cliente)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "fithub://auth"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "fithub://auth"
      }
    },
    {
      "clientId": "fithub-account-service",
      "name": "account-service (atribuição de papel de profissional)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${FITHUB_ACCOUNT_SERVICE_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "kc-admin-api"
      ],
      "optionalClientScopes": [],
      "attributes": {}
    },
    {
      "clientId": "admin-permissions",
      "enabled": true,
      "bearerOnly": false,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": true,
      "attributes": {
        "realm_client": "false"
      },
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "resources": [
          {
            "name": "Users",
            "type": "Users",
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "manage"
              },
              {
                "name": "map-roles"
              },
              {
                "name": "manage-group-membership"
              },
              {
                "name": "impersonate"
              },
              {
                "name": "reset-password"
              },
              {
                "name": "delegate"
              }
            ]
          },
          {
            "name": "Roles",
            "type": "Roles",
            "scopes": [
              {
                "name": "map-role"
              },
              {
                "name": "map-role-composite"
              },
              {
                "name": "map-role-client-scope"
              }
            ]
          },
          {
            "name": "Clients",
            "type": "Clients",
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "manage"
              },
              {
                "name": "map-roles"
              },
              {
                "name": "map-roles-composite"
              },
              {
                "name": "map-roles-client-scope"
              }
            ]
          },
          {
            "name": "Groups",
            "type": "Groups",
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "manage"
              },
              {
                "name": "view-members"
              },
              {
                "name": "manage-members"
              },
              {
                "name": "manage-membership"
              },
              {
                "name": "manage-membership-of-members"
              },
              {
                "name": "delegate-members"
              },
              {
                "name": "impersonate-members"
              }
            ]
          },
          {
            "name": "Organizations",
            "type": "Organizations",
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "manage"
              }
            ]
          },
          {
            "name": "7d1c2b3a-0147-4f00-9a01-000000000001",
            "scopes": [
              {
                "name": "map-role"
              },
              {
                "name": "map-role-composite"
              },
              {
                "name": "map-role-client-scope"
              }
            ]
          },
          {
            "name": "7d1c2b3a-0147-4f00-9a01-000000000002",
            "scopes": [
              {
                "name": "map-role"
              },
              {
                "name": "map-role-composite"
              },
              {
                "name": "map-role-client-scope"
              }
            ]
          }
        ],
        "policies": [
          {
            "name": "account-service",
            "type": "client",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "clients": "[\"fithub-account-service\"]"
            }
          },
          {
            "name": "account-service-users",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Users",
              "resources": "[\"Users\"]",
              "scopes": "[\"view\",\"manage\",\"map-roles\"]",
              "applyPolicies": "[\"account-service\"]"
            }
          },
          {
            "name": "account-service-professional-roles",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Roles",
              "resources": "[\"7d1c2b3a-0147-4f00-9a01-000000000001\",\"7d1c2b3a-0147-4f00-9a01-000000000002\"]",
              "scopes": "[\"map-role\"]",
              "applyPolicies": "[\"account-service\"]"
            }
          }
        ],
        "scopes": [
          {
            "name": "view"
          },
          {
            "name": "manage"
          },
          {
            "name": "map-roles"
          },
          {
            "name": "manage-group-membership"
          },
          {
            "name": "impersonate"
          },
          {
            "name": "reset-password"
          },
          {
            "name": "delegate"
          },
          {
            "name": "map-role"
          },
          {
            "name": "map-role-composite"
          },
          {
            "name": "map-role-client-scope"
          },
          {
            "name": "map-roles-composite"
          },
          {
            "name": "map-roles-client-scope"
          },
          {
            "name": "view-members"
          },
          {
            "name": "manage-members"
          },
          {
            "name": "manage-membership"
          },
          {
            "name": "manage-membership-of-members"
          },
          {
            "name": "delegate-members"
          },
          {
            "name": "impersonate-members"
          }
        ]
      }
    }
  ],
  "users": [
    {
      "username": "service-account-fithub-account-service",
      "enabled": true,
      "serviceAccountClientId": "fithub-account-service",
      "realmRoles": [],
      "clientRoles": {
        "realm-management": [
          "view-realm"
        ]
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "fithub-account-service",
        "roles": [
          "view-realm"
        ]
      }
    ]
  },
  "adminPermissionsEnabled": true
}
