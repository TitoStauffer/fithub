# Variáveis do docker-compose.dev.yml (DEV-0012). Copie para .env nesta pasta só
# se quiser trocar algum valor; sem .env, valem os padrões abaixo.
# Valores apenas de desenvolvimento local: nunca reutilize em outro ambiente.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Senha dos usuários account, client, training, nutrition e keycloak.
FITHUB_DB_PASSWORD=fithub

RABBITMQ_USER=fithub
RABBITMQ_PASSWORD=fithub
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

S3_ACCESS_KEY=fithub-dev
S3_SECRET_KEY=fithub-dev-secret
S3_PORT=8333

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

GRAFANA_PORT=3000
OTLP_HTTP_PORT=4318

# Sistema inteiro no ambiente local (DEV-0181, docker-compose.app.yml). FITHUB_HOST é o único lugar do endereço do PC:
# o IP da máquina na rede (ipconfig, "Endereço IPv4"), para o celular alcançar, com FITHUB_BIND=0.0.0.0. Sem eles, vale
# localhost, só no PC. A senha de teste vale para as três contas do seed; é só deste ambiente local.
FITHUB_HOST=localhost
FITHUB_BIND=127.0.0.1
FITHUB_EDGE_PORT=8000
FITHUB_SEED_PASSWORD=fithub-teste-local
# Chave do sandbox do Asaas, opcional (checkout da assinatura). Começa com $: fica entre aspas simples.
# ASAAS_API_KEY='<chave-do-sandbox>'
