# Modelo do .env de produção (DEV-0110). Na VPS, copie para infra/compose/.env (ignorado pelo Git), troque cada
# <...> e deixe o arquivo só para o dono (chmod 600). Nenhum valor real entra no repositório.
# Gere senhas e secrets longos e aleatórios, por exemplo: openssl rand -base64 32

# Domínio público (sem https://), com o DNS apontando para a VPS, e o e-mail de avisos do Let's Encrypt.
FITHUB_DOMAIN=<dominio>
ACME_EMAIL=<email-de-avisos-do-certificado>

# Postgres: superusuário (backup e restauração) e uma senha diferente para o usuário de cada banco. Cada serviço
# recebe só a sua: comprometer um serviço não abre o banco de outro nem o do Keycloak.
POSTGRES_PASSWORD=<senha>
ACCOUNT_DB_PASSWORD=<senha>
CLIENT_DB_PASSWORD=<senha>
TRAINING_DB_PASSWORD=<senha>
NUTRITION_DB_PASSWORD=<senha>
KEYCLOAK_DB_PASSWORD=<senha>

# RabbitMQ: o administrador, só para a operação, e uma senha por serviço (o usuário tem o nome do serviço).
RABBITMQ_ADMIN_USER=<usuario>
RABBITMQ_ADMIN_PASSWORD=<senha>
ACCOUNT_RABBITMQ_PASSWORD=<senha>
CLIENT_RABBITMQ_PASSWORD=<senha>
TRAINING_RABBITMQ_PASSWORD=<senha>
NUTRITION_RABBITMQ_PASSWORD=<senha>

# Administrador do Keycloak (console só por túnel SSH) e o secret do client fithub-account-service (ADR-008).
KEYCLOAK_ADMIN=<usuario>
KEYCLOAK_ADMIN_PASSWORD=<senha>
FITHUB_ACCOUNT_SERVICE_SECRET=<secret>

# Storage S3 das fotos (SeaweedFS): uma identidade por serviço, cada uma só com o próprio bucket. Use 8 ou mais
# caracteres entre letras, números e + / = _ . - (por exemplo openssl rand -hex 20).
CLIENT_S3_ACCESS_KEY=<access-key>
CLIENT_S3_SECRET_KEY=<secret-key>
NUTRITION_S3_ACCESS_KEY=<access-key>
NUTRITION_S3_SECRET_KEY=<secret-key>

# SMTP do e-mail de convite (client-service), com autenticação e STARTTLS.
SMTP_HOST=<host-smtp>
SMTP_PORT=587
SMTP_USERNAME=<usuario-smtp>
SMTP_PASSWORD=<senha-smtp>
FITHUB_MAIL_FROM=FitHub <nao-responda@<dominio>>

# Opcionais: dono das imagens no GHCR (minúsculas) e horário do backup (cron, UTC).
# FITHUB_IMAGE_OWNER=titostauffer
# BACKUP_SCHEDULE=0 3 * * *
