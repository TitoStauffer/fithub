# Modelo do .env de produção (DEV-0110). Na VPS, copie para infra/compose/.env (ignorado pelo Git), troque cada
# <...> e deixe o arquivo só para o dono (chmod 600). Nenhum valor real entra no repositório.
# Gere senhas e secrets longos e aleatórios, por exemplo: openssl rand -base64 32

# Domínio público (sem https://), com o DNS apontando para a VPS, e o e-mail de avisos do Let's Encrypt.
FITHUB_DOMAIN=<dominio>
ACME_EMAIL=<email-de-avisos-do-certificado>

# Postgres: superusuário (backup e restauração) e a senha dos usuários dos bancos dos serviços e do Keycloak.
POSTGRES_PASSWORD=<senha>
FITHUB_DB_PASSWORD=<senha>

RABBITMQ_USER=<usuario>
RABBITMQ_PASSWORD=<senha>

# Administrador do Keycloak (console só por túnel SSH) e o secret do client fithub-account-service (ADR-008).
KEYCLOAK_ADMIN=<usuario>
KEYCLOAK_ADMIN_PASSWORD=<senha>
FITHUB_ACCOUNT_SERVICE_SECRET=<secret>

# Storage S3 das fotos (SeaweedFS).
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>

# SMTP do e-mail de convite (client-service), com autenticação e STARTTLS.
SMTP_HOST=<host-smtp>
SMTP_PORT=587
SMTP_USERNAME=<usuario-smtp>
SMTP_PASSWORD=<senha-smtp>
FITHUB_MAIL_FROM=FitHub <nao-responda@<dominio>>

# Opcionais: dono das imagens no GHCR (minúsculas) e horário do backup (cron, UTC).
# FITHUB_IMAGE_OWNER=titostauffer
# BACKUP_SCHEDULE=0 3 * * *
