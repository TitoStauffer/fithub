{
  "uid": "fithub-metricas",
  "title": "FitHub — Métricas de sucesso",
  "description": "Métricas de sucesso do PRD (seção 19, DEV-0113): só contagens agregadas, sem dado de pessoa.",
  "tags": [
    "fithub"
  ],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Profissionais por estado da assinatura",
      "description": "Ativo = período pago valendo (pagante, depois da DEV-0100); em teste = teste grátis valendo; expirado = nenhum dos dois.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type, status) (fithub_professionals)",
          "legendFormat": "{{type}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Clientes ativos por profissional",
      "description": "Vínculos ativos divididos pelos profissionais com ao menos um vínculo ativo.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (fithub_links_active) / sum by (type) (fithub_professionals_with_active_links)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Engajamento semanal dos clientes vinculados (%)",
      "description": "Clientes vinculados que registraram treino (PERSONAL) ou refeição feita ou parcial (NUTRITIONIST) nos últimos 7 dias. Os dois serviços têm bancos separados: a união \"treino ou refeição\" não é calculada.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (type) (fithub_clients_linked_engaged) / sum by (type) (fithub_clients_linked)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Prescrições publicadas por profissional (30 dias)",
      "description": "Versões de ficha e de plano alimentar publicadas nos últimos 30 dias, divididas pelos profissionais que publicaram. A ficha que o próprio cliente monta não conta.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (fithub_prescriptions_published) / sum by (type) (fithub_prescribers_active)",
          "legendFormat": "{{type}} por profissional"
        },
        {
          "refId": "B",
          "expr": "sum by (type) (fithub_prescriptions_published)",
          "legendFormat": "{{type}} total"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Clientes que seguem usando depois do fim do vínculo (30 dias)",
      "description": "Clientes sem vínculo ativo que registraram treino ou refeição depois do fim do último vínculo, nos últimos 30 dias.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (fithub_clients_after_link_end)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Conversão do teste para pago (%)",
      "description": "Profissionais com o teste grátis já terminado que têm ao menos uma cobrança confirmada (DEV-0100).",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (type) (fithub_professionals_converted) / sum by (type) (fithub_professionals_trial_ended)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Retenção mensal de profissionais (%)",
      "description": "Profissionais com cobrança confirmada que vence no mês passado e que também têm cobrança confirmada neste mês (meses de São Paulo).",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (type) (fithub_professionals_retained) / sum by (type) (fithub_professionals_paid_last_month)",
          "legendFormat": "{{type}}"
        }
      ]
    }
  ]
}
