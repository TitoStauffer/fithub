<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Regras mínimas do FitHub (DEV-0129, ENGENHARIA.md §5). A formatação é do Spotless (palantir-java-format);
  aqui ficam só o que o formatador não decide: imports, nomes e complexidade. Camadas são do ArchUnit.
  Regra nova entra aqui com o código existente já em conformidade; o CI roda em todos os módulos.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="FileTabCharacter"/>

  <!-- Nos testes e na lib de testes, regras do ArchUnit e contêineres do Testcontainers são campos static final em camelCase. -->
  <module name="SuppressionSingleFilter">
    <property name="checks" value="ConstantName"/>
    <property name="files" value="([\/]src[\/]test|[\/]libs[\/]java-testing)[\/]"/>
  </module>

  <module name="TreeWalker">
    <!-- Imports -->
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>
    <module name="IllegalImport"/>

    <!-- Nomes (identificadores em inglês, AGENTS.md) -->
    <module name="PackageName">
      <property name="format" value="^com\.fithub(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="LocalFinalVariableName"/>
    <module name="StaticVariableName"/>
    <!-- Logger como "log" é o padrão do projeto. -->
    <module name="ConstantName">
      <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
    </module>
    <module name="ClassTypeParameterName"/>
    <module name="MethodTypeParameterName"/>

    <!-- Complexidade e armadilhas comuns -->
    <module name="CyclomaticComplexity">
      <property name="max" value="12"/>
      <property name="switchBlockAsSingleDecisionPoint" value="true"/>
    </module>
    <!-- Guarda curta numa linha só (if (x) return y;) é aceita; bloco em mais de uma linha exige chaves. -->
    <module name="NeedBraces">
      <property name="allowSingleLineStatement" value="true"/>
    </module>
    <module name="EqualsHashCode"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="StringLiteralEquality"/>
    <module name="MissingSwitchDefault"/>
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignored"/>
    </module>
  </module>
</module>
