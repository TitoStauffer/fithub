# Só para o `pnpm --filter web dev` (DEV-0156). As APIs passam pelo proxy do Vite (src/devProxy.ts) na mesma origem
# da página, como no Traefik de produção; nenhum serviço precisa de CORS. Sem segredos aqui.
VITE_ACCOUNT_API_URL=/api/account
VITE_CLIENT_API_URL=/api/client
VITE_TRAINING_API_URL=/api/training
VITE_NUTRITION_API_URL=/api/nutrition
