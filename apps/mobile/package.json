{
    "name": "mobile",
    "private": true,
    "version": "0.1.0",
    "description": "App mobile do cliente: Expo + React Native + TypeScript (DEV-0021).",
    "main": "index.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "test": "jest --ci"
    },
    "dependencies": {
        "expo": "58.0.23",
        "expo-status-bar": "58.0.4",
        "react": "19.3.0",
        "react-native": "0.88.1"
    },
    "devDependencies": {
        "@react-native/jest-preset": "0.88.1",
        "@testing-library/react-native": "14.1.0",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "babel-preset-expo": "58.0.24",
        "eslint": "9.39.5",
        "eslint-config-expo": "58.0.4",
        "jest": "30.5.2",
        "jest-expo": "58.0.14",
        "jest-junit": "17.0.0",
        "test-renderer": "1.3.1",
        "typescript": "6.0.3"
    },
    "jest": {
        "preset": "jest-expo",
        "reporters": [
            "default",
            [
                "jest-junit",
                {
                    "outputDirectory": "reports",
                    "outputName": "junit.xml"
                }
            ]
        ]
    }
}
