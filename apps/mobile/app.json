{
    "expo": {
        "name": "FitHub",
        "slug": "fithub",
        "version": "0.1.0",
        "orientation": "portrait",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": false
        },
        "android": {},
        "plugins": [
            "expo-secure-store",
            "expo-web-browser",
            [
                "expo-image-picker",
                {
                    "cameraPermission": "O FitHub usa a câmera para as fotos de evolução da sua avaliação.",
                    "photosPermission": false,
                    "microphonePermission": false
                }
            ]
        ],
        "scheme": "fithub"
    }
}
