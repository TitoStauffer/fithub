<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- nutrition-service (DEV-0015): Alimentos, planos e registro de refeições. Esqueleto hexagonal sobre a java-commons. -->
  <parent>
    <groupId>com.fithub</groupId>
    <artifactId>fithub-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>nutrition-service</artifactId>
  <name>FitHub Nutrition Service</name>

  <dependencies>
    <!-- Foto do prato no SeaweedFS pela API S3, com URL pré-assinada (DEV-0088), como as fotos de evolução do
         client-service (DEV-0048). O cliente HTTP é o do próprio JDK (url-connection-client), sem netty nem Apache. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <!-- Segurança, Problem Details, logging JSON, outbox, Flyway, Actuator e RabbitMQ. -->
    <dependency>
      <groupId>com.fithub</groupId>
      <artifactId>java-commons</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
    </dependency>

    <dependency>
      <groupId>com.fithub</groupId>
      <artifactId>java-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Teste de consumidor (DEV-0151): os payloads publicados no teste cumprem os contratos. -->
    <dependency>
      <groupId>com.fithub</groupId>
      <artifactId>event-contracts</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
