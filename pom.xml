<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Parent do monorepo (DEV-0011). Herda o gerenciamento de dependências e plugins do Spring Boot.
    Spring Boot 4.1.3: linha estável mais recente; a 4.2.0 saiu em 19/11/2026 e entra depois de um patch.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.3</version>
    <relativePath/>
  </parent>

  <groupId>com.fithub</groupId>
  <artifactId>fithub-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>FitHub</name>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.4.1</archunit.version>
    <!-- Linha 3.1 do springdoc: a construída sobre o Spring Boot 4.1 (a 3.2 já usa o 4.2). -->
    <springdoc.version>3.1.1</springdoc.version>
    <!-- Linha 3 do validador: usa o Jackson 3 (tools.jackson), o mesmo do Spring Boot 4. -->
    <json-schema-validator.version>3.0.9</json-schema-validator.version>
    <!-- Padrão de código (DEV-0129): formatação pelo Spotless com palantir-java-format e lint pelo Checkstyle. -->
    <spotless.version>3.11.0</spotless.version>
    <palantir-java-format.version>2.103.0</palantir-java-format.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>14.4.0</checkstyle.version>
    <!-- Cliente S3 das fotos de evolução (DEV-0048, ADR-006): SeaweedFS pela API S3. -->
    <awssdk.version>2.57.9</awssdk.version>
  </properties>

  <!-- Módulos entram conforme forem criados: libs (DEV-0013, DEV-0014, DEV-0018) e serviços (DEV-0015). -->
  <modules>
    <module>libs/java-commons</module>
    <module>libs/java-testing</module>
    <module>libs/event-contracts</module>
    <module>services/account-service</module>
    <module>services/client-service</module>
    <module>services/training-service</module>
    <module>services/nutrition-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fithub</groupId>
        <artifactId>java-commons</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fithub</groupId>
        <artifactId>java-testing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fithub</groupId>
        <artifactId>event-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Falha cedo com Java ou Maven abaixo do exigido. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>require-java-and-maven</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>O FitHub exige Java 25 (ENGENHARIA.md). Aponte o JAVA_HOME para um JDK 25.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Padrão de código (DEV-0129, ENGENHARIA.md §5). Os dois goals rodam no CI (job Java Services) e
        localmente; não estão ligados ao ciclo de build, então o mvn verify e o build das imagens não
        dependem do histórico do Git.
          mvn spotless:apply                    formata os arquivos alterados
          mvn spotless:check checkstyle:check   o que o CI confere
        O Spotless confere só os arquivos que mudaram em relação à origin/master (ratchet): o código
        anterior ao padrão é formatado quando for tocado, sem um PR de formatação em massa.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <ratchetFrom>origin/master</ratchetFrom>
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
              <style>PALANTIR</style>
            </palantirJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${maven-checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>warning</violationSeverity>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
