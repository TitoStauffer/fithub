<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.fithub</groupId>
    <artifactId>backend-parent</artifactId>
    <version>0.3.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>boot</artifactId>
  <packaging>jar</packaging>

  <description>
    Ponto de entrada da aplicação FitHub. Monta o classpath (todos os módulos de domínio +
    platform) e sobe o contexto Spring Boot.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.fithub</groupId>
      <artifactId>shared-kernel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fithub</groupId>
      <artifactId>platform</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fithub</groupId>
      <artifactId>identity</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fithub</groupId>
      <artifactId>patients</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fithub</groupId>
      <artifactId>training</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fithub</groupId>
      <artifactId>nutrition</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.3.0</version>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>fithub-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.fithub.boot.FitHubApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
